{
  "dashboard": {
    "title": "Microservices Request Distribution",
    "tags": ["microservices", "requests"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Requests Rate by Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\"security-service|uploader-service|api-gateway\"}[5m])",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "Container CPU Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\"security-service|uploader-service|api-gateway|minio\"}[5m]) * 100",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "CPU %"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Container Memory Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\"security-service|uploader-service|api-gateway|minio\"}",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "title": "Network I/O by Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\"security-service|uploader-service|api-gateway\"}[5m])",
            "legendFormat": "{{name}} - RX",
            "refId": "A"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{name=~\"security-service|uploader-service|api-gateway\"}[5m])",
            "legendFormat": "{{name}} - TX",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 5,
        "title": "Request Distribution (Pie Chart)",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"security-service|uploader-service|api-gateway\"}[5m]))",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        }
      },
      {
        "id": 6,
        "title": "System Load Average",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "node_load1",
            "legendFormat": "1m load",
            "refId": "A"
          },
          {
            "expr": "node_load5",
            "legendFormat": "5m load",
            "refId": "B"
          },
          {
            "expr": "node_load15",
            "legendFormat": "15m load",
            "refId": "C"
          }
        ]
      }
    ],
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s"
  },
  "overwrite": true
}
